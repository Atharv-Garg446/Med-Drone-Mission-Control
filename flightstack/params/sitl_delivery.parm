# Extra SITL defaults loaded after ArduPilot's copter.parm.
# Used by flightstack/sitl.py for the delivery demonstrations.
#
# ---- Frame & propulsion configuration (MedDrone-Hexa-16) ----
# Override ArduPilot's default FRAME_CLASS=1 (Quad) to match the
# MedDrone-Hexa-16 VehicleProfile (num_rotors=6) in vehicle_model.py
# AND pair with --model hexa:med_drone_hexa_16.json in flightstack/sitl.py
# so both AP_MotorsMatrix (control) and SIM_Multicopter (physics) simulate
# 6 motors in Plus ("+") geometry. (Using --model "+" with FRAME_CLASS=2
# leaves physics with 4 motors and prevents takeoff.)
FRAME_CLASS      2
FRAME_TYPE       0
MOT_THST_EXPO    0.65
MOT_THST_HOVER   0.42
MOT_BAT_VOLT_MAX 25.2
MOT_BAT_VOLT_MIN 19.8
EK3_DRAG_BCOEF_X 55.6
EK3_DRAG_BCOEF_Y 55.6
EK3_DRAG_MCOEF   0.177
#
# Servo gripper on SERVO9, simulated by ArduPilot's SIM_GRPS model, so the
# hover-and-release / ground-release step (MAV_CMD_DO_GRIPPER) has a real
# actuator that attaches a 1.0 kg external load on takeoff and drops it on
# release.
GRIP_ENABLE      1
GRIP_TYPE        1
SERVO9_FUNCTION  28
SIM_GRPS_ENABLE  1
SIM_GRPS_PIN     9
#
# Finite 6S 16 Ah LiPo battery coupled with med_drone_hexa_16.json
# (maxVoltage=25.2 V, refVoltage=22.2 V, battCapacityAh=16.0, refBatRes=0.012).
# SIM_BATT_VOLTAGE=25.04 V initializes SIM_Battery at 100% SoC (6 * 4.173 V/cell).
SIM_BATT_VOLTAGE 25.04
SIM_BATT_CAP_AH  16
BATT_CAPACITY    16000
#
# Mission speeds (cm/s) -- planner cruise speed must match WPNAV_SPEED.
WPNAV_SPEED      1000
RTL_ALT          6000
#
# Land-and-deliver: MIS_OPTIONS bit 2 (ContinueAfterLand) lets an AUTO mission
# continue with NAV_TAKEOFF after NAV_LAND. Without it ArduCopter disarms on
# touchdown and ends the mission (observed in SITL, 2026-10-26).
MIS_OPTIONS      4
#
# Native ArduPilot Obstacle Avoidance (BendyRuler) via C++ SITL Raycasting Proximity Sensor
# PRX1_TYPE = 10 (AP_Proximity_SITL) raycasts 8 sectors in C++ against world obstacles
# stored in AC_PolyFence_loader while FENCE_ENABLE = 0 keeps geofence failsafe actions off.
FENCE_ENABLE     0
FENCE_ALT_MAX    120
PRX1_TYPE        10
PRX1_MIN         0.2
PRX1_MAX         50.0
OA_TYPE          1
OA_MARGIN_MAX    10.0
OA_OPTIONS       5
OA_DB_EXPIRE     10.0
OA_DB_OUTPUT     3
OA_DB_RADIUS_MIN 3.0
OA_BR_LOOKAHEAD  35.0
SR0_ADSB         5
